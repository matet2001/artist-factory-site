# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...but the template carries no secrets and the README tells you to copy it
!.env.example

# sensitive data
/data/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local editor / agent state
/.idea/
.claude/settings.local.json

# database dumps — never commit, these contain personal data
/backups/
*.dump
*.sql.gz
database-backup-*.json

# agent tooling output
/graphify-out/
