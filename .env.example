# ─── Database ────────────────────────────────────────────────────────────────
# Which database DATABASE_URL points at. Required by every script in scripts/.
# Scripts that write refuse to run against "production" without --allow-production.
DB_ENVIRONMENT=development

# Neon connection string. For local work this should be a *development branch*,
# never the production branch — see "Development database" in the README.
DATABASE_URL="postgresql://user:password@ep-xxxx.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# ─── Auth ────────────────────────────────────────────────────────────────────
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with: openssl rand -base64 32"

# ─── Email ───────────────────────────────────────────────────────────────────
# "smtp" or "resend"
EMAIL_PROVIDER=smtp
EMAIL_FROM="noreply@artistfactory.hu"
# Where new-booking notifications go
ADMIN_EMAIL="artistfactory@artistfactory.hu"
BUG_REPORT_EMAIL="artistfactory@artistfactory.hu"

# SMTP (when EMAIL_PROVIDER=smtp)
EMAIL_SERVER_HOST=""
EMAIL_SERVER_PORT="465"
EMAIL_SERVER_USER=""
EMAIL_SERVER_PASSWORD=""

# Resend (when EMAIL_PROVIDER=resend)
RESEND_API_KEY=""

# ─── Cron ────────────────────────────────────────────────────────────────────
# Bearer token Vercel Cron sends to /api/cron/cleanup-planned.
# Generate with: openssl rand -hex 32
CRON_SECRET=""

# ─── Seeding (optional) ──────────────────────────────────────────────────────
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""
